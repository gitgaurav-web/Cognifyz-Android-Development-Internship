<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp"
    android:gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVEL 4 • TASK 8"
                android:textColor="@color/level_4"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Smooth Intent Navigation"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Passes data with explicit Intent and executes custom transition animations."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Message to pass">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nav_custom_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome from Gaurav Kumar to Cognifyz!" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_navigate_slide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Slide Transition Navigation ?"
                android:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btn_navigate_fade"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Fade Transition Navigation ?"
                android:textColor="@color/secondary"
                app:strokeColor="@color/secondary"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
