<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Live API, Haptics, Notifications & Network status -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.CognifyzInternship">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Main Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CognifyzInternship.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AI Assistant Activity -->
        <activity
            android:name=".ai.AiAssistantActivity"
            android:label="Cognifyz Task Helper" />

        <!-- Level 1: Beginner -->
        <activity
            android:name=".level1.HelloWorldActivity"
            android:label="@string/task_1_title" />
        <activity
            android:name=".level1.ButtonInteractionActivity"
            android:label="@string/task_2_title" />

        <!-- Level 2: Intermediate -->
        <activity
            android:name=".level2.ListDisplayActivity"
            android:label="@string/task_3_title" />
        <activity
            android:name=".level2.BasicUiLayoutActivity"
            android:label="@string/task_4_title" />
        <activity
            android:name=".level2.ProfileDetailsActivity"
            android:label="Profile Details Screen" />

        <!-- Level 3: Advanced -->
        <activity
            android:name=".level3.FetchDisplayDataActivity"
            android:label="@string/task_5_title" />
        <activity
            android:name=".level3.SimpleFormActivity"
            android:label="@string/task_6_title" />

        <!-- Level 4: Expert -->
        <activity
            android:name=".level4.SqliteDatabaseActivity"
            android:label="@string/task_7_title" />
        <activity
            android:name=".level4.NavigationActivity"
            android:label="@string/task_8_title" />
        <activity
            android:name=".level4.SecondScreenActivity"
            android:label="Second Screen Activity" />

    </application>

</manifest>
